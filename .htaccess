# Clean URL untuk hosting Apache (cPanel / Hostinger / Niagahoster)
Options -MultiViews
RewriteEngine On

# 1) Redirect permanen: /shop.html -> /shop
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# /index -> /
RewriteRule ^index/?$ / [R=301,L]

# 2) Tampilkan file .html saat diakses tanpa ekstensi: /shop -> shop.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
