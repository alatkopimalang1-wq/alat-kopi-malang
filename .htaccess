# ==============================================================================
# ALAT KOPI MALANG - CLEAN URL CONFIGURATION (.htaccess)
# ==============================================================================

Options -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Lewatkan file fisik yang ada (CSS, JS, Gambar, Video, Font)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 2. Redirect /index.html atau /index ke root / (301 Permanent)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index(\.html)?[\s?] [NC]
    RewriteRule ^index(\.html)?$ / [R=301,L]

    # 3. Redirect permanen jika URL browser berakhiran .html ke clean URL
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+?)\.html[\s?] [NC]
    RewriteRule ^(.+?)\.html$ /%1 [R=301,L,NE]

    # 4. Handle route admin secara khusus
    RewriteRule ^admin/?$ admin.html [L,QSA]

    # 5. Rewrite internal: sajikan file .html untuk clean URL
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^(.+?)/?$ $1.html [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+?)/?$ $1.html [L,QSA]
</IfModule>

<IfModule mod_mime.c>
    AddType text/html .html
    AddType text/css .css
    AddType text/javascript .js
    AddType image/svg+xml .svg
    AddType image/webp .webp
    AddType video/mp4 .mp4
</IfModule>

